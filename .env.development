# App
PORT=3000
NEXT_PUBLIC_SITE_NAME=IndiesBrasil
NEXT_PUBLIC_BASE_URL=localhost
#Security
# Cost do bcrypt no ambiente local (producao ignora este arquivo e usa 14).
PASSWORD_HASH_ROUNDS=1
PEPPER="3.14mentinha"

#DB
POSTGRES_HOST=localhost
POSTGRES_DB=local_db
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
POSTGRES_CA_PATH = /etc/ssl/postgres/root.crt
#Email
EMAIL_HTTP_HOST=localhost
# 4080/4025 (e não 1080/1025): portas do host escolhidas em `infra/compose.yaml`
# porque o Rockstar Games Launcher (`RLHostService`) ocupa a 1025 no Windows e
# engole a conexão SMTP sem responder — o e-mail de ativação nunca chegava.
EMAIL_HTTP_PORT=4080

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=4025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

#FileUpload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=
# Streaming
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
#Store
NEXT_PUBLIC_STORE_SALES_ENABLED=false
