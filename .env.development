# App
PORT=3000
NEXT_PUBLIC_SITE_NAME=IndiesBrasil
NEXT_PUBLIC_BASE_URL=localhost
#Security
PEPPER="3.14mentinha"

#DB
POSTGRES_HOST=localhost
POSTGRES_DB=local_db
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
POSTGRES_CA_PATH = /etc/ssl/postgres/root.crt
#Email
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

#FileUpload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=
# Streaming
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
#Store
NEXT_PUBLIC_STORE_SALES_ENABLED=true

#LiveKit (reunioes por video - SFU local)
# O LiveKit exige API key e secret com no minimo 32 caracteres
# (config.ValidateKeys) para validar o par de chaves.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey-0123456789abcdef0123456789abcdef
LIVEKIT_API_SECRET=devsecret-0123456789abcdef0123456789abcdef
